generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  SUPERADMIN
}

enum CourseLevel {
  Beginner
  Intermediate
  Advanced
  AllLevels
}

enum CourseBadge {
  Hot
  Bestseller
  New
  TopRated
}

enum LessonType {
  video
  article
  quiz
}

// ─────────────────────────────────────────────
// PAYMENT ENUMS
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  FREE
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id String @id @default(uuid())

  // Money
  amount         Int
  originalAmount Int?
  currency       String @default("inr")

  // Status
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod

  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  stripeCustomerId      String?
  webhookEventId        String?

  // Refund
  refundId      String?
  refundedAt    DateTime?
  failureReason String?

  // Snapshot data
  courseTitle         String
  coursePriceSnapshot Float

  // Relations
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollmentId String?     @unique
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("orders")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id          String  @id @default(uuid())
  name        String
  email       String  @unique
  password    String
  avatar      String?
  role        Role    @default(STUDENT)
  bio         String?
  headline    String?
  website     String?
  socialLinks Json? // { twitter, linkedin, youtube, ... }

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instructorCourses Course[]        @relation("InstructorCourses")
  enrollments       Enrollment[]
  orders            Order[]
  reviews           Review[]
  reviewHelpfuls    ReviewHelpful[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  subcategories Subcategory[]
  courses       Course[]

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  name       String
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  courses    Course[]

  @@unique([slug, categoryId])
  @@map("subcategories")
}

// ─────────────────────────────────────────────
// COURSE
// ─────────────────────────────────────────────

model Course {
  id           String  @id @default(uuid())
  slug         String  @unique
  title        String
  subtitle     String?
  description  String
  image        String?
  previewVideo String?

  // Pricing
  price         Float  @default(0)
  originalPrice Float?

  // Meta
  language    String       @default("English")
  level       CourseLevel  @default(Beginner)
  badge       CourseBadge?
  lastUpdated String?

  // Stats (denormalized for performance)
  rating        Float @default(0)
  reviewCount   Int   @default(0)
  studentCount  Int   @default(0)
  totalHours    Float @default(0)
  totalLectures Int   @default(0)
  totalArticles Int   @default(0)

  // Features
  hasCertificate    Boolean @default(true)
  hasLifetimeAccess Boolean @default(true)
  hasMobileAccess   Boolean @default(true)

  // Published state
  isDraft     Boolean @default(true)
  isPublished Boolean @default(false)
  isApproved  Boolean @default(false)

  // Relations
  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  whatYouWillLearn WhatYouWillLearn[]
  requirements     Requirement[]
  tags             CourseTag[]
  sections         Section[]
  reviews          Review[]
  enrollments      Enrollment[]

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

// ─────────────────────────────────────────────
// COURSE METADATA LISTS
// ─────────────────────────────────────────────

model WhatYouWillLearn {
  id       String @id @default(uuid())
  text     String
  order    Int    @default(0)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("what_you_will_learn")
}

model Requirement {
  id       String @id @default(uuid())
  text     String
  order    Int    @default(0)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("requirements")
}

model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  courses CourseTag[]

  @@map("tags")
}

model CourseTag {
  courseId String
  tagId    String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tags")
}

// ─────────────────────────────────────────────
// CURRICULUM
// ─────────────────────────────────────────────

model Section {
  id            String  @id @default(uuid())
  title         String
  totalDuration String?
  order         Int     @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

model Lesson {
  id        String     @id @default(uuid())
  title     String
  duration  String?
  isPreview Boolean    @default(false)
  type      LessonType @default(video)
  videoUrl  String?
  content   String? // for article type
  order     Int        @default(0)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id      String  @id @default(uuid())
  rating  Int
  content String
  helpful Int     @default(0)
  date    String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  helpfuls ReviewHelpful[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, courseId])
  @@map("reviews")
}

model ReviewHelpful {
  userId   String
  reviewId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_helpfuls")
}

// ─────────────────────────────────────────────
// ENROLLMENTS
// ─────────────────────────────────────────────

model Enrollment {
  id        String @id @default(uuid())
  studentId String
  courseId  String

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  progress    Float     @default(0)

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  order Order?

  @@unique([studentId, courseId])
  @@map("enrollments")
}
